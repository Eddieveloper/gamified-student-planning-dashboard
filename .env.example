# Local development or a manually configured Vercel environment
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Supabase/Vercel integrations commonly provide one of these instead.
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NON_POOLING=...